# COMPOSE ENVIRONMENT VARIABLES
# Volumes
LOCAL_WS=${PWD}/../../  # devcontainer: ${PWD}/ | docker compose: ${PWD}/../
VISION_WS=${LOCAL_WS}/packages

# ..........................................................................................................
